# --- Fitur simulasi OMNI ---
# EFI/RPM: telemetri dari scripts/omni_efi_mavlink_sim.py (opsional, tak blokir arming)
EFI_TYPE 9
RPM1_TYPE 3
# Rangefinder DEFAULT MATI (mengikuti pesawat referensi yang terbukti terbang).
# FDM eksternal JSBSim tidak menyuplai data ke tipe 100/SITL -> PreArm "No Data".
# Untuk memakai rangefinder: set RNGFND1_TYPE 10 (MAVLink) + jalankan
# scripts/omni_rangefinder_mavlink_sim.py (otomatis bila lewat launcher GUI).
RNGFND1_TYPE 0
RNGFND_LANDING 0
LOG_DISARMED 1

# --- Pengaman (dipin eksplisit setelah insiden crash RTL Jul 2026) ---
ARMING_CHECK 1
ARSPD_SKIP_CAL 0

# --- Batas aerodinamika, DIUKUR dari FDM (Jul 2026) ---
# Berat 15,0 kg (147 N) | luas sayap 0,75 m2
# Stall sayap datar 15,3 m/s | bank 35deg 16,9 m/s | bank 45deg 18,2 m/s
# Drag jelajah 22 m/s ~27 N | thrust tersedia 22 m/s full 63,6 N (margin 2,4x)
# Laju panjat maksimum teoritis 5,5 m/s -> TECS_CLMB_MAX 3,5 memberi cadangan.
# AIRSPEED_MIN WAJIB di atas stall: 18 = 1,18x stall (dulu 10 -> stall & jatuh).

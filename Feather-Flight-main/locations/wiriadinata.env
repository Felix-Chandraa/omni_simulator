# P5 — SATU SUMBER LOKASI (SDD Bab 8). Jangan tebar angka ini ke file lain;
# tools/gen_location_config.py yang menyebarkannya (config.js, locations.txt AP,
# active_location.json, blok start_location profil SITL).
#
# SEMUA nilai di bawah [VERIFY-LOCAL] — seed dari riset A.4. Prosedur final
# (SDD §8 langkah 1-2): ukur SEKALI dari citra satelit + parkir SITL, isi ulang.

NAME=Wiriadinata

# Titik spawn (disarankan: threshold runway 15, ujung barat-laut) + heading true
# sejajar centerline. Seed = ARP aproks; ganti dgn threshold presisi.
LAT=-7.346914
LON=108.2463725
ALT_M=349.0          # sumber sebut 335/338/349/352 — UKUR, jangan tebak
HDG_TRUE=327.7       # runway 15, magvar ~1°E -> ~151° true

# Posisi GCS (apron/tower pilihan instruktur) utk views.ground.gcs.
GCS_LAT=-7.346288
GCS_LON=108.246224
GCS_ALT_M=

# --- Kalibrasi geoid lokasi (SDD §8 langkah 2) — ukur SEKALI, dipakai P1 ---
# CESIUM_TERRAIN_M = globe.getHeight(Cesium) di titik spawn (parkir).
# SITL_MSL_M       = alt_msl stream/telemetri saat parkir di titik yang sama.
# gen tool menghitung GEOID_OFFSET_M = CESIUM_TERRAIN_M - SITL_MSL_M.
CESIUM_TERRAIN_M=357.55
SITL_MSL_M=349.0

# --- Opsional: dua ujung runway (citra satelit). Bila DIISI, gen tool
# menghitung HDG_TRUE dari sini (menimpa nilai di atas). RWY15 = ujung
# barat-laut (threshold 15). ---
RWY15_LAT=-7.354103
RWY15_LON=108.250961
RWY33_LAT=-7.342176
RWY33_LON=108.243348